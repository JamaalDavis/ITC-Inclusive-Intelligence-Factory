{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ITC Task Context",
  "type": "object",
  "required": [
    "task_id",
    "topic",
    "audience",
    "deliverable",
    "approval_required"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string",
      "minLength": 1
    },
    "audience": {
      "type": "string",
      "minLength": 1
    },
    "deliverable": {
      "enum": [
        "article",
        "carousel",
        "research_brief"
      ]
    },
    "approval_required": {
      "const": true
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "accessibility_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}